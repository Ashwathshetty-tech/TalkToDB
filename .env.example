# App
PORT=3001
NODE_ENV=development

# --- Database: TWO connections, on purpose ---
# ADMIN_DATABASE_URL: used only at boot, to create the sample schema/data and
# to create the read-only role below. Never used to run a generated query.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5433/sql_ai_chat

# The password for the read-only Postgres role that actually executes
# generated SQL. Must match the password embedded in READONLY_DATABASE_URL.
READONLY_DB_PASSWORD=readonly_pw

# READONLY_DATABASE_URL: the ONLY connection SqlExecutorService uses. This
# role is granted SELECT on the allowed tables and nothing else — it is the
# real safety boundary, independent of any validation logic in the app.
READONLY_DATABASE_URL=postgres://sql_chat_readonly:readonly_pw@localhost:5433/sql_ai_chat

# Claude API (used for both SQL generation and result explanation)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# Which tables the model is allowed to reference and the executor is granted
# SELECT on. Anything else gets rejected by the validator even if the model
# somehow generates SQL touching it.
ALLOWED_TABLES=customers,products,orders,order_items

# Guardrails on generated queries
DEFAULT_ROW_LIMIT=200
MAX_ROW_LIMIT=1000
QUERY_TIMEOUT_MS=5000
